    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
```

### React-Based Block (edit.js)

```javascript
import { useBlockProps, InspectorControls, InnerBlocks } from '@wordpress/block-editor';
import { PanelBody, ToggleControl } from '@wordpress/components';
import { __ } from '@wordpress/i18n';

export default function Edit({ attributes, setAttributes }) {
  const { allowMultiple } = attributes;
  const blockProps = useBlockProps();

  return (
    <>
      <InspectorControls>
        <PanelBody title={__('Accordion Settings', 'tenup')}>
          <ToggleControl
            label={__('Allow Multiple Open', 'tenup')}
            checked={allowMultiple}
            onChange={(value) => setAttributes({ allowMultiple: value })}
          />
        </PanelBody>
      </InspectorControls>

      <div {...blockProps}>
        <InnerBlocks
          allowedBlocks={['tenup/accordion-item']}
          template={[
            ['tenup/accordion-item', { title: __('First Item', 'tenup') }],
            ['tenup/accordion-item', { title: __('Second Item', 'tenup') }],
          ]}
        />
      </div>
    </>
  );
}
```

### PHP Render Callback (render.php)

```php
<?php
/**
 * Accordion Block Render Callback
 *
 * @param array    $attributes Block attributes.
 * @param string   $content    Block content.
 * @param WP_Block $block      Block instance.
 * @return string Rendered block HTML.
 */

$allow_multiple = $attributes['allowMultiple'] ?? false;
$wrapper_attributes = get_block_wrapper_attributes([
  'class' => 'wp-block-tenup-accordion',
  'data-allow-multiple' => $allow_multiple ? 'true' : 'false',
]);

?>
<div <?php echo $wrapper_attributes; ?>>
  <?php echo $content; ?>
</div>
```

