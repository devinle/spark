### WordPress REST API Integration

```php
<?php
/**
 * Add REST API endpoint for accordion data
 */

add_action('rest_api_init', function () {
  register_rest_route('tenup/v1', '/accordion/(?P<id>\d+)', [
    'methods' => 'GET',
    'callback' => 'tenup_get_accordion_data',
    'permission_callback' => '__return_true',
  ]);
});

function tenup_get_accordion_data($request) {
  $post_id = $request['id'];
  // Return accordion data as JSON
  return rest_ensure_response([
    'items' => get_field('accordion_items', $post_id),
  ]);
}
```

## Testing for WordPress Components

### PHP Unit Tests (PHPUnit)

```php
<?php
/**
 * Test Accordion Block Registration
 */

class Test_Accordion_Block extends WP_UnitTestCase {
  
  public function test_block_is_registered() {
    $registry = WP_Block_Type_Registry::get_instance();
    $this->assertTrue($registry->is_registered('tenup/accordion'));
  }
  
  public function test_block_renders_correctly() {
    $content = '<!-- wp:tenup/accordion {"allowMultiple":true} /-->';
    $rendered = do_blocks($content);
    
    $this->assertStringContainsString('wp-block-tenup-accordion', $rendered);
    $this->assertStringContainsString('data-allow-multiple="true"', $rendered);
  }
  
  public function test_accordion_accessibility() {
    $rendered = render_accordion_block([
      'items' => [
        ['title' => 'Test', 'content' => 'Content']
      ]
    ]);
    
    // Check for ARIA attributes
    $this->assertStringContainsString('aria-expanded', $rendered);
    $this->assertStringContainsString('role="region"', $rendered);
  }
}
```

