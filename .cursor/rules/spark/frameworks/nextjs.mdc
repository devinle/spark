## Server Actions

```typescript
// components/ui/accordion/actions.ts
'use server';

import { revalidatePath } from 'next/cache';

export async function updateAccordionItem(formData: FormData) {
  const id = formData.get('id') as string;
  const title = formData.get('title') as string;
  const content = formData.get('content') as string;
  
  // Update database
  await db.accordion.update({
    where: { id },
    data: { title, content },
  });
  
  revalidatePath('/dashboard');
  
  return { success: true };
}
