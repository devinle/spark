## Data Fetching Patterns

### Server Component Data Fetching

```typescript
// components/ui/accordion/accordion.tsx
// Server Component - can fetch directly

async function getAccordionItems() {
  // Direct database access, no API route needed
  const res = await fetch('https://api.example.com/faqs', {
    cache: 'force-cache', // or 'no-store' for dynamic
  });
  
  if (!res.ok) throw new Error('Failed to fetch');
  
  return res.json();
}

export async function Accordion() {
  const items = await getAccordionItems();
  
  return <AccordionClient items={items} />;
}
```

### Client Component Data Fetching

```typescript
// components/ui/accordion/accordion-dynamic.tsx
'use client';

import { useState, useEffect } from 'react';
import useSWR from 'swr';

export function AccordionDynamic() {
  const { data, error, isLoading } = useSWR('/api/faqs', fetcher);
  
  if (error) return <div>Failed to load</div>;
  if (isLoading) return <AccordionSkeleton />;
  
  return <AccordionClient items={data} />;
}
```

