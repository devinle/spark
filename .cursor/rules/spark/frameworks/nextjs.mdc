## Server Components vs Client Components

### Decision Tree

```
Component Request
    ↓
Does it need interactivity?
    ├─ NO → Server Component (default)
    │   ├─ Data fetching in component
    │   ├─ Direct database access
    │   ├─ Async operations
    │   └─ No bundle sent to client
    │
    └─ YES → Check interaction type
        ├─ State management → Client Component
        ├─ Event handlers → Client Component
        ├─ Browser APIs → Client Component
        ├─ useEffect/useState → Client Component
        └─ React hooks → Client Component
```

### Accordion Example

**Server Component Wrapper:**
```typescript
// components/ui/accordion/accordion.tsx
// Server Component (default - no 'use client')

import { AccordionClient } from './accordion-client';

export interface AccordionItem {
  id: string;
  title: string;
  content: string;
}

interface AccordionProps {
  items: AccordionItem[];
  defaultOpen?: string[];
  allowMultiple?: boolean;
  className?: string;
}

export async function Accordion({ items, ...props }: AccordionProps) {
  // Can fetch data here, access database, etc.
  // No JavaScript sent to client for this wrapper
  
  return <AccordionClient items={items} {...props} />;
}
```

**Client Component (Interactive):**
```typescript
// components/ui/accordion/accordion-client.tsx
'use client';

import { useState } from 'react';
import { cn } from '@/lib/utils';
import type { AccordionItem } from './accordion';

interface AccordionClientProps {
  items: AccordionItem[];
  defaultOpen?: string[];
  allowMultiple?: boolean;
  className?: string;
}

export function AccordionClient({
  items,
  defaultOpen = [],
  allowMultiple = false,
  className
}: AccordionClientProps) {
  const [openItems, setOpenItems] = useState<Set<string>>(
    new Set(defaultOpen)
  );

  const toggleItem = (id: string) => {
    setOpenItems((prev) => {
      const next = new Set(prev);
      
      if (next.has(id)) {
        next.delete(id);
      } else {
        if (!allowMultiple) {
          next.clear();
        }
        next.add(id);
      }
      
      return next;
    });
  };

  return (
    <div className={cn('accordion', className)}>
      {items.map((item) => (
        <AccordionItem
          key={item.id}
          item={item}
          isOpen={openItems.has(item.id)}
          onToggle={() => toggleItem(item.id)}
        />
      ))}
    </div>
  );
}

interface AccordionItemProps {
  item: AccordionItem;
  isOpen: boolean;
  onToggle: () => void;
}

function AccordionItem({ item, isOpen, onToggle }: AccordionItemProps) {
  return (
    <div className="accordion__item">
      <h3 className="accordion__header">
        <button
          className="accordion__trigger"
          onClick={onToggle}
          aria-expanded={isOpen}
          aria-controls={`accordion-content-${item.id}`}
          id={`accordion-trigger-${item.id}`}
        >
          <span className="accordion__title">{item.title}</span>
          <svg 
            className={cn('accordion__icon', isOpen && 'rotate-180')}
            aria-hidden="true"
            width="24" 
            height="24" 
            viewBox="0 0 24 24"
          >
            <path d="M6 9L12 15L18 9" stroke="currentColor" strokeWidth="2" />
          </svg>
        </button>
      </h3>
      <div
        id={`accordion-content-${item.id}`}
        className="accordion__content"
        role="region"
        aria-labelledby={`accordion-trigger-${item.id}`}
        hidden={!isOpen}
      >
        <div className="accordion__body">
          {item.content}
        </div>
      </div>
    </div>
  );
}
```

## Component Generation Patterns

### File Structure for Next.js Components

**Recommended Structure (App Router):**
```
components/ui/accordion/
├── accordion.tsx                  # Server Component (wrapper/data)
├── accordion-client.tsx           # Client Component (interactive)
├── accordion.module.css           # Styles (or Tailwind)
├── accordion.test.tsx            # Tests
├── accordion.stories.tsx         # Storybook (if using)
├── types.ts                      # Shared types
└── README.md                     # Documentation
```

**Alternative Structure (Colocation):**
```
components/ui/accordion/
├── index.ts                      # Exports
├── server.tsx                    # Server Component
├── client.tsx                    # Client Component
├── styles.module.css             # Styles
├── types.ts                      # Types
└── README.md                     # Docs
```

