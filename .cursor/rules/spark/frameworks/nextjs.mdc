```

### Client Component Testing

```typescript
// components/ui/accordion/accordion-client.test.tsx
import { render, screen, fireEvent } from '@testing-library/react';
import { AccordionClient } from './accordion-client';

describe('AccordionClient', () => {
  const items = [
    { id: '1', title: 'Question 1', content: 'Answer 1' },
    { id: '2', title: 'Question 2', content: 'Answer 2' },
  ];

  it('toggles items on click', () => {
    render(<AccordionClient items={items} />);
    
    const trigger = screen.getByText('Question 1');
    fireEvent.click(trigger);
    
    expect(screen.getByText('Answer 1')).toBeVisible();
  });
  
  it('respects allowMultiple prop', () => {
    render(<AccordionClient items={items} allowMultiple={false} />);
    
    fireEvent.click(screen.getByText('Question 1'));
    fireEvent.click(screen.getByText('Question 2'));
    
    // Only second should be open
    expect(screen.getByText('Answer 2')).toBeVisible();
    expect(screen.queryByText('Answer 1')).not.toBeVisible();
  });
});
```

## Performance Optimization

### 1. Dynamic Imports

```typescript
// app/page.tsx
import dynamic from 'next/dynamic';

const Accordion = dynamic(() => import('@/components/ui/accordion'), {
  loading: () => <AccordionSkeleton />,
  ssr: false, // Only if needed
});

export default function Page() {
  return <Accordion items={items} />;
}
```

### 2. Suspense Boundaries

```typescript
// app/dashboard/page.tsx
import { Suspense } from 'react';
import { Accordion } from '@/components/ui/accordion';
import { AccordionSkeleton } from '@/components/ui/accordion/skeleton';

export default function Dashboard() {
  return (
    <Suspense fallback={<AccordionSkeleton />}>
      <Accordion />
    </Suspense>
  );
}
```

### 3. Memoization

```typescript
// components/ui/accordion/accordion-client.tsx
'use client';

import { memo, useMemo } from 'react';

export const AccordionClient = memo(function AccordionClient({
  items,
  className
}: AccordionClientProps) {
  const sortedItems = useMemo(
    () => [...items].sort((a, b) => a.order - b.order),
    [items]
  );
  
  return (
    <div className={className}>
      {sortedItems.map((item) => (
        <AccordionItem key={item.id} item={item} />
      ))}
    </div>
  );
});
```

## TypeScript Configuration

```json
// tsconfig.json (Next.js recommended)
{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
```

